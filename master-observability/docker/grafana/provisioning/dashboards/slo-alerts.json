{
    "annotations": { "list": [] },
    "editable": true,
    "graphTooltip": 1,
    "links": [],
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Checkout failure ratio vs SLO (10%)",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "unit": "percent",
                    "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "none" }, "lineInterpolation": "smooth" },
                    "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 8 }, { "color": "red", "value": 10 } ] }
                },
                "overrides": []
            },
            "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
            "targets": [
                { "expr": "sum(rate(checkout_failure_total{application=\"observability-shop\"}[2m])) / clamp_min(sum(rate(checkout_total{application=\"observability-shop\"}[2m])), 1) * 100", "legendFormat": "failure ratio %", "refId": "A" },
                { "expr": "10", "legendFormat": "SLO 10%", "refId": "B" }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Alerts currently firing (Prometheus ALERTS metric)",
            "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "color": { "mode": "thresholds" },
                    "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 } ] }
                },
                "overrides": []
            },
            "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } },
            "targets": [
                { "expr": "count(ALERTS{alertstate=\"firing\"})", "legendFormat": "firing", "refId": "A" }
            ]
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Business metric vs infrastructure health",
            "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops",
                    "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "none" } }
                },
                "overrides": []
            },
            "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
            "targets": [
                { "expr": "rate(checkout_failure_total{application=\"observability-shop\"}[1m])", "legendFormat": "checkout failures/s", "refId": "A" },
                { "expr": "1 - avg_over_time(up[1m])", "legendFormat": "% instances down", "refId": "B" }
            ]
        },
        {
            "id": 4,
            "type": "timeseries",
            "title": "Sampling decision volume (kept vs dropped by tail_sampling)",
            "gridPos": { "h": 8, "w": 18, "x": 0, "y": 8 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
                },
                "overrides": []
            },
            "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
            "targets": [
                { "expr": "sum by (reason) (rate(trace_sampling_decision_total{application=\"observability-shop\"}[1m]))", "legendFormat": "{{reason}}", "refId": "A" }
            ]
        },
        {
            "id": 5,
            "type": "logs",
            "title": "Every trace_id logged this session (Loki)",
            "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
            "datasource": { "type": "loki", "uid": "loki" },
            "targets": [
                { "expr": "{service=\"app\"} | json | line_format \"{{.trace_id}} {{.message}}\"", "refId": "A", "datasource": { "type": "loki", "uid": "loki" } }
            ],
            "options": {
                "showTime": true,
                "sortOrder": "Descending",
                "enableLogDetails": true
            }
        }
    ],
    "refresh": "5s",
    "schemaVersion": 39,
    "tags": [ "observability", "slo" ],
    "templating": { "list": [] },
    "time": { "from": "now-30m", "to": "now" },
    "timepicker": {},
    "title": "SLO, Alerts & Sampling",
    "uid": "obs-shop-slo",
    "version": 1
}